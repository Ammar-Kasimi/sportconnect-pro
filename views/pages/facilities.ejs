<main class="container">
    <h1>Infrastructures Municipales</h1>
    
    <table class="table">
        <thead>
            <tr>
                <th>Nom de l'infrastructure</th>
                <th>Adresse</th>
                <th>Capacité ERP</th>
                <th>Divisible ?</th>
            </tr>
        </thead>
        <tbody>
            <% facilities.forEach(function(facility) { %>
                <tr>
                    <td><%= facility.name %></td>
                    <td><%= facility.address %></td>
                    <td><%= facility.erp_capacity %> personnes</td>
                    
                    <td>
                        <% if (facility.is_divisible) { %>
                            <span class="badge success">Oui</span>
                        <% } else { %>
                            <span class="badge error">Non</span>
                        <% } %>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</main>
<%- include('../partials/header') %>

<div class="max-w-lg mx-auto bg-white p-8 rounded-xl border border-slate-200 shadow-sm">
    <h2 class="text-xl font-bold text-slate-900 mb-6">Ajouter un Foyer Fiscal</h2>
    
    <form action="/families" method="POST" class="space-y-6">
        <div>
            <label class="block text-sm font-medium text-slate-700">Code Famille (ex: FAM-DUPONT) *</label>
            <input type="text" name="family_code" required class="mt-1 block w-full rounded-md border-slate-300 border p-2 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm">
        </div>
        
        <div>
            <label class="block text-sm font-medium text-slate-700">Quotient Familial (€) *</label>
            <input type="number" step="0.01" name="quotient_familial" required class="mt-1 block w-full rounded-md border-slate-300 border p-2 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm">
            <p class="text-xs text-slate-500 mt-1">Utilisé pour le calcul automatique des bourses municipales.</p>
        </div>

        <div class="pt-4 border-t border-slate-100 flex justify-end gap-3">
            <a href="/families" class="px-4 py-2 border border-slate-300 rounded-md text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 transition">Annuler</a>
            <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-md text-sm font-medium hover:bg-indigo-700 transition shadow-sm">
                Enregistrer
            </button>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/header') %>

<div class="max-w-2xl mx-auto mb-8">
    <h1 class="text-3xl font-bold text-slate-900">
        <%= locals.facility ? 'Modifier l\'Installation' : 'Nouvelle Installation' %>
    </h1>
    <p class="text-slate-500 mt-1">Gérez les bâtiments et infrastructures sportives de la commune.</p>
</div>

<div class="max-w-2xl mx-auto bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <form action="<%= locals.facility ? '/facilities/' + facility.id + '/edit' : '/facilities' %>" method="POST" class="space-y-6">
        
        <div>
            <label for="name" class="block text-sm font-medium text-slate-700 mb-1">Nom de l'Installation</label>
            <input type="text" id="name" name="name" required
                value="<%= locals.facility ? facility.name : '' %>"
                class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none">
        </div>

        <div>
            <label for="address" class="block text-sm font-medium text-slate-700 mb-1">Adresse complète</label>
            <textarea id="address" name="address" rows="3" required
                class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none"><%= locals.facility ? facility.address : '' %></textarea>
        </div>

        <div>
            <label for="erp_capacity" class="block text-sm font-medium text-slate-700 mb-1">Capacité Maximale (ERP)</label>
            <input type="number" id="erp_capacity" name="erp_capacity" required min="1"
                value="<%= locals.facility ? facility.erp_capacity : '' %>"
                class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none">
            <p class="text-xs text-slate-500 mt-1">Nombre maximum de personnes autorisées simultanément dans le bâtiment.</p>
        </div>

        <div class="flex items-center mt-4">
            <input type="checkbox" id="is_divisible" name="is_divisible" 
                <%= locals.facility && facility.is_divisible ? 'checked' : '' %>
                class="w-5 h-5 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
            <label for="is_divisible" class="ml-3 block text-sm font-medium text-slate-700">
                Installation divisible en sous-zones (ex: Dojo A et Dojo B)
            </label>
        </div>

        <div class="flex justify-end pt-4 border-t border-slate-100">
            <a href="/facilities" class="px-6 py-2 text-slate-600 hover:bg-slate-50 rounded-lg font-medium mr-2">Annuler</a>
            <button type="submit" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium">
                <%= locals.facility ? 'Mettre à jour' : 'Enregistrer' %>
            </button>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/header') %>

<div class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">Tableau de Bord Métropolitain</h1>
    <p class="text-slate-500 text-sm mt-1">Supervision globale des infrastructures, activités et jauges de sécurité.</p>
</div>

<!-- Section 1 : Métriques de base -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Infrastructures</span>
        <div class="mt-2 flex items-baseline gap-2">
            <span class="text-3xl font-extrabold text-slate-800"><%= stats.facilitiesCount %></span>
        </div>
    </div>

    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Associations</span>
        <div class="mt-2 flex items-baseline gap-2">
            <span class="text-3xl font-extrabold text-slate-800"><%= stats.clubsCount %></span>
        </div>
    </div>

    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Activités</span>
        <div class="mt-2 flex items-baseline gap-2">
            <span class="text-3xl font-extrabold text-indigo-600"><%= stats.activitiesCount %></span>
        </div>
    </div>
</div>

<!-- Section 2 : Analytique Financière & Remplissage (Jour 9) -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="bg-slate-900 p-6 rounded-xl border border-slate-800 shadow-sm text-white">
        <span class="text-xs font-semibold text-indigo-400 uppercase tracking-wider">Recettes Cumulées</span>
        <div class="mt-2 flex items-baseline gap-2">
            <span class="text-3xl font-extrabold text-emerald-400"><%= stats.totalRevenue %> €</span>
        </div>
    </div>

    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Taux de Remplissage</span>
        <div class="mt-2 flex items-baseline gap-2">
            <span class="text-3xl font-extrabold text-orange-500"><%= stats.fillRate %>%</span>
        </div>
        <!-- Barre de progression visuelle -->
        <div class="w-full bg-slate-100 rounded-full h-2 mt-4">
            <div class="bg-orange-500 h-2 rounded-full transition-all duration-500" style="width: <%= stats.fillRate %>%"></div>
        </div>
    </div>

    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-center">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">État du Système</span>
        <div class="flex items-center gap-3">
            <span class="relative flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
            </span>
            <span class="text-sm font-semibold text-slate-700">PostgreSQL Connecté</span>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
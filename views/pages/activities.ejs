<%- include('../partials/header') %>
<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="sm:flex sm:items-center sm:justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Catalogue des Activités</h1>
            <p class="mt-2 text-sm text-slate-600">Gérez les cours, leurs horaires et leurs affectations.</p>
        </div>
        <div class="mt-4 sm:mt-0">
            <a href="/activities/new" class="inline-flex items-center justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-colors">
                + Créer un nouveau cours
            </a>
        </div>
    </div>

    <div class="bg-white shadow-sm ring-1 ring-slate-200 rounded-lg overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Activité</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Club (Association)</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Lieu (Salle)</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Jour & Horaire</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Capacité</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Tarif</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-slate-200">
                    <% activities.forEach(function(activity) { %>
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900"><%= activity.name %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= activity.club_name %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= activity.facility_name %></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600">
                                <span class="font-medium text-slate-800"><%= activity.day_of_week %></span> <br>
                                <span class="text-xs text-slate-500"><%= activity.start_time %> - <%= activity.end_time %></span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= activity.max_capacity %> places</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-emerald-600"><%= activity.base_price %> €</td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                <div class="flex justify-end gap-3">
                                    <a href="/activities/<%= activity.id %>/edit" class="text-indigo-600 hover:text-indigo-900">Modifier</a>
                                    <form action="/activities/<%= activity.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce cours ?');">
                                        <button type="submit" class="text-red-600 hover:text-red-900">Supprimer</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>
</main>
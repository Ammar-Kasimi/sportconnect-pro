<%- include('../partials/header') %>

<div class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">Tableau de Bord Métropolitain</h1>
    <p class="text-slate-500 text-sm mt-1">Supervision globale des infrastructures, activités et jauges de sécurité.</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Complexes -->
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Infrastructures</span>
        <div class="mt-2 flex items-baseline gap-2">
            <span class="text-3xl font-extrabold text-slate-800"><%= stats.facilitiesCount %></span>
            <span class="text-xs text-slate-500">sites enregistrés</span>
        </div>
    </div>

    <!-- Activités -->
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Activités</span>
        <div class="mt-2 flex items-baseline gap-2">
            <span class="text-3xl font-extrabold text-indigo-600"><%= stats.activitiesCount %></span>
            <span class="text-xs text-slate-500">cours ouverts</span>
        </div>
    </div>

    <!-- Statut Système -->
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Moteur HTTP</span>
        <div class="mt-2 flex items-center gap-2">
            <span class="h-3 w-3 rounded-full bg-emerald-500 inline-block"></span>
            <span class="text-sm font-semibold text-slate-700">Native node:http actif</span>
        </div>
        <p class="text-xs text-slate-400 mt-1">Pool PostgreSQL opérationnel</p>
    </div>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/header') %>
    <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="bg-white rounded-xl shadow-sm ring-1 ring-slate-200 p-8">
            <div class="mb-8 border-b border-slate-100 pb-5">
                <h1 class="text-2xl font-bold text-slate-900">Planifier une nouvelle activité</h1>
                <p class="mt-1 text-sm text-slate-500">Remplissez les détails pour ouvrir un nouveau créneau sportif.
                </p>
            </div>

            <form action="/activities" method="POST" class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Nom de l'activité (ex: Judo
                        U11)</label>
                    <input type="text" name="name" required
                        class="w-full rounded-md border border-slate-300 px-4 py-2 text-slate-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all">
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Club Organisateur</label>
                        <select name="association_id" required
                            class="w-full rounded-md border border-slate-300 px-4 py-2 text-slate-900 bg-white focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all">
                            <option value="">-- Sélectionnez un club --</option>
                            <% clubs.forEach(function(club) { %>
                                <option value="<%= club.id %>">
                                    <%= club.name %>
                                </option>
                                <% }); %>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Infrastructure (Salle)</label>
                        <select name="facility_id" required
                            class="w-full rounded-md border border-slate-300 px-4 py-2 text-slate-900 bg-white focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all">
                            <option value="">-- Sélectionnez une salle --</option>
                            <% facilities.forEach(function(facility) { %>
                                <option value="<%= facility.id %>">
                                    <%= facility.name %> (Max: <%= facility.erp_capacity %>)
                                </option>
                                <% }); %>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Jour</label>
                        <select name="day_of_week" required
                            class="w-full rounded-md border border-slate-300 px-4 py-2 text-slate-900 bg-white focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all">
                            <option value="Lundi">Lundi</option>
                            <option value="Mardi">Mardi</option>
                            <option value="Mercredi">Mercredi</option>
                            <option value="Jeudi">Jeudi</option>
                            <option value="Vendredi">Vendredi</option>
                            <option value="Samedi">Samedi</option>
                            <option value="Dimanche">Dimanche</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Heure de début</label>
                        <input type="time" name="start_time" required
                            class="w-full rounded-md border border-slate-300 px-4 py-2 text-slate-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Heure de fin</label>
                        <input type="time" name="end_time" required
                            class="w-full rounded-md border border-slate-300 px-4 py-2 text-slate-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pb-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Capacité maximale</label>
                        <input type="number" name="max_capacity" required
                            class="w-full rounded-md border border-slate-300 px-4 py-2 text-slate-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Tarif de base annuel (€)</label>
                        <input type="number" step="0.01" name="base_price" required
                            class="w-full rounded-md border border-slate-300 px-4 py-2 text-slate-900 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all">
                    </div>
                </div>
                <div class="mb-4">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="is_high_risk"
                            class="w-4 h-4 text-indigo-600 rounded border-slate-300" <%=locals.activity &&
                            activity.is_high_risk ? 'checked' : '' %>>
                        <span class="text-sm font-medium text-slate-700">Sport à contraintes (Certificat médical < 1 an
                                requis)</span>
                    </label>
                </div>
                <div class="pt-4 border-t border-slate-100 flex justify-end gap-3">
                    <a href="/activities"
                        class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-md hover:bg-slate-50 transition-colors">Annuler</a>
                    <button type="submit"
                        class="px-6 py-2 text-sm font-medium text-white bg-indigo-600 rounded-md hover:bg-indigo-700 focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors">Enregistrer
                        l'activité</button>
                </div>
            </form>
        </div>
    </main>